# build output and the root symlink to it
build/
/bunzi
# local only: the original art and the tools that turn it into assets/*/gen
# (the game reads only gen/, the level files and the sounds)
tools/
*_raw.png
spritecook-assets.json
__pycache__/
# local only: unused art (cat hero, rejected tilesets, mockups, templates)
extras/
# frame dumps
*.ppm
# only the sounds sounds.txt plays go up; add a line here when you pick another
# variant (the others stay on disk, see tools/make_sounds.py)
assets/sounds/*.wav
!assets/sounds/ambience_night.wav
!assets/sounds/clear_a.wav
!assets/sounds/coin_b.wav
